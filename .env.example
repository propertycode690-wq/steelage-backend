PORT="5000"
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="change-this-to-a-secure-random-secret-key"
JWT_EXPIRES_IN="7d"
DISABLE_REDIS="true"

# Database & Redis Configuration
DATABASE_URL="mysql://username:password@localhost:3306/database_name"
REDIS_URL="redis://localhost:6379"

# AWS S3 Configuration
AWS_ACCESS_KEY_ID="your_aws_access_key_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key_here"
AWS_BUCKET_NAME="your_aws_bucket_name_here"
AWS_REGION="us-east-1"

# OpenAI Configuration
OPENAI_API_KEY="your_openai_api_key_here"

# SMTP / Email Settings
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your_smtp_user@example.com"
SMTP_PASS="your_smtp_password_here"
SMTP_FROM="\"Company Name\" <no-reply@example.com>"
SMTP_SECURE="false"

# Resend API
RESEND_API_KEY="your_resend_api_key_here"
RESEND_FROM_EMAIL="no-reply@example.com"

# Stripe Payments
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"

# Twilio WhatsApp & SMS
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Zoho Integration
ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"
ZOHO_API_URL="https://www.zohoapis.com/invoice/v3"
ZOHO_CLIENT_ID="your_zoho_client_id_here"
ZOHO_CLIENT_SECRET="your_zoho_client_secret_here"
ZOHO_ORGANIZATION_ID="your_zoho_org_id_here"
ZOHO_REFRESH_TOKEN="your_zoho_refresh_token_here"

# Zoom Integration
ZOOM_ACCOUNT_ID="your_zoom_account_id_here"
ZOOM_CLIENT_ID="your_zoom_client_id_here"
ZOOM_CLIENT_SECRET="your_zoom_client_secret_here"
ZOOM_WEBHOOK_SECRET_TOKEN="your_zoom_webhook_secret_here"

# Meta API Secret
META_APP_SECRET="your_meta_app_secret_here"
